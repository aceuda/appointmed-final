<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imageDoctorAvatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@mipmap/ic_launcher_round"
            android:background="@drawable/bg_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/textDoctorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Dr. John Doe"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/imageDoctorAvatar"
            app:layout_constraintStart_toEndOf="@id/imageDoctorAvatar"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/textDoctorSpecialty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cardiology"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/textDoctorName"
            app:layout_constraintStart_toStartOf="@id/textDoctorName"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/textDoctorClinic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Heart Clinic"
            android:textSize="13sp"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/textDoctorSpecialty"
            app:layout_constraintStart_toStartOf="@id/textDoctorName"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/textDoctorClinic"
            app:layout_constraintStart_toStartOf="@id/textDoctorName"
            app:layout_constraintEnd_toStartOf="@id/btnBookDoctor">

            <TextView
                android:id="@+id/textDoctorRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 4.8"
                android:textSize="13sp"
                android:textColor="#f59e0b"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/textDoctorFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱500"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnBookDoctor"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Book"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_btn_primary"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
