<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Top bar: Back + Title -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/textSecondary"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="AppointMed"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />
        </RelativeLayout>

        <!-- Brand Title (Large) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appoint"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#475569" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Med"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#38BDF8" />
        </LinearLayout>

        <!-- Welcome Back heading -->
        <TextView
            android:id="@+id/loginHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Back"
            android:textSize="26sp"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please enter your credentials to access your\nclinical dashboard."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <!-- Role Tab Selector: Patient | Doctor (Excluded Admin) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_container"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/buttonPatient"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_tab_active"
                android:text="Patient"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:stateListAnimator="@null"
                android:elevation="1dp" />

            <Button
                android:id="@+id/buttonDoctor"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_tab_inactive"
                android:text="Doctor"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:stateListAnimator="@null" />

            <!-- Hidden Admin Button -->
            <Button
                android:id="@+id/buttonAdmin"
                android:layout_width="0dp"
                android:layout_weight="0"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Error Message -->
        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <!-- Success Message -->
        <TextView
            android:id="@+id/textMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/success"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <!-- Email Address Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Email Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_auth"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_dialog_email"
                android:tint="#94A3B8"
                android:layout_marginEnd="12dp"
                android:contentDescription="Email icon" />

            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="name@clinic.com"
                android:textColorHint="#94A3B8"
                android:inputType="textEmailAddress"
                android:background="@android:color/transparent"
                android:textSize="15sp"
                android:textColor="#1E293B" />
        </LinearLayout>

        <!-- Password Label + Forgot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buttonForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot?"
                android:textColor="#475569"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Password Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_auth"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_lock_idle_lock"
                android:tint="#94A3B8"
                android:layout_marginEnd="12dp"
                android:contentDescription="Lock icon" />

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="••••••••"
                android:textColorHint="#94A3B8"
                android:inputType="textPassword"
                android:background="@android:color/transparent"
                android:textSize="15sp"
                android:textColor="#1E293B" />

            <ImageView
                android:id="@+id/buttonTogglePassword"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_view"
                android:tint="#94A3B8"
                android:contentDescription="Toggle password"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Sign In Button -->
        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_dark"
            android:text="Sign In ➔"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Register Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New to AppointMed? "
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/buttonGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register now"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
